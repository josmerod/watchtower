# Watchtower Environment Configuration
# Copy to .env and fill in what you have: nothing here is required for a
# keyless run. Settings use the WATCHTOWER_ prefix and __ between a section and
# its field (pydantic-settings). The other names are read by the code that
# names them, section by section below.

# === Application ===
WATCHTOWER_ENVIRONMENT=development  # development|production|testing
WATCHTOWER_DEBUG=false
WATCHTOWER_APP_NAME=Watchtower

# === API ===
WATCHTOWER_API__HOST=0.0.0.0
WATCHTOWER_API__PORT=8000

# === Scraping ===
WATCHTOWER_SCRAPING__TIMEOUT=30
WATCHTOWER_SCRAPING__MAX_RETRIES=3
WATCHTOWER_SCRAPING__RETRY_DELAY=5
WATCHTOWER_SCRAPING__CONCURRENT_LIMIT=10
WATCHTOWER_SCRAPING__RATE_LIMIT=1.0
WATCHTOWER_SCRAPING__PLAYWRIGHT_HEADLESS=true

# === Logging ===
WATCHTOWER_LOGGING__LEVEL=INFO
WATCHTOWER_LOGGING__FILE_ENABLED=true
WATCHTOWER_LOGGING__CONSOLE_ENABLED=true

# === Keys and variables the ETLs read (all optional) ===
# deployment/deploy.py forwards to the production container exactly the names
# in this section that are set, and nothing else from this file. What an ETL
# does without its key is noted next to it.
GITHUB_TOKEN=  # GitHub API: without a token requests get the anonymous rate limit (GH_TOKEN is the alternative)
GH_TOKEN=
PRODUCTHUNT_API_TOKEN=  # Product Hunt GraphQL API; without it the ETL falls back to the RSS feed
NVD_API_KEY=  # NVD CVE feed: without a key requests get the lower rate limit
ARTIFICIAL_ANALYSIS_API_KEY=  # Artificial Analysis v2 API answers 401 without it
REPLICATE_API_TOKEN=  # without it the Replicate ETL is skipped
API_ITAD_KEY=  # IsThereAnyDeal: without it the ETL is skipped
WATCHTOWER_API__NEWS_API_KEY=  # NewsAPI.org: without it the ETL is skipped
WATCHTOWER_API__STACKEXCHANGE_KEY=  # Stack Exchange API: without it requests get the lower quota
# Polite-pool contact for OpenAlex and Crossref: an email address, not a secret
OPENALEX_MAILTO=
CROSSREF_MAILTO=
# Seconds between ETL cycles (deployment/etl_scheduler.py); 7200 when unset.
# Leave it unset rather than empty: the launcher cannot parse an empty value.
# WATCHTOWER_ETL_INTERVAL=7200

# === IPTorrents RSS (src/etl/goldigging/goldigging_scavenging_etl.py) ===
# Required for the ipt sources in scavenging.json; those feeds are skipped when unset.
IPT_USER_ID=
IPT_PASSKEY=

# === Unraid deployment (deployment/*.py, scripts/debug_remote_logs.py) ===
# These stay on the deploying machine: they are not in the forwarded list.
UNRAID_HOST=
UNRAID_USER=root
UNRAID_PASSWORD=
# Browserless / Chromium endpoint for the Playwright ETLs; defaults to the Unraid host on port 3000.
# BROWSERLESS_ENDPOINT=ws://<host>:3000

# === Coda.io integration (scripts/sync_to_coda.py, fetch_coda_tasks.py, upload_new_tasks.py) ===
CODA_API_KEY=

# === LLM (optional; only where AI enrichment is enabled) ===
# WATCHTOWER_LLM__PROVIDER=openai
# WATCHTOWER_LLM__MODEL=
# WATCHTOWER_LLM__OPENAI_API_KEY=
# WATCHTOWER_LLM__OPENAI_BASE_URL=
# WATCHTOWER_LLM__ANTHROPIC_API_KEY=

# === Google Drive (optional; run_backup.py uploads from a developer machine) ===
# WATCHTOWER_GOOGLE_DRIVE__CREDENTIALS_FILE=
# WATCHTOWER_GOOGLE_DRIVE__BACKUP_FOLDER_ID=

# === Paths (auto-detected when unset) ===
# WATCHTOWER_PROJECT_ROOT=/path/to/watchtower
# WATCHTOWER_DATA_DIR=data
# WATCHTOWER_LOGS_DIR=logs
