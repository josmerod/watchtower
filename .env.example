# Watchtower Environment Configuration
# Copy to .env and fill in values
# All vars use WATCHTOWER_ prefix (auto-stripped by pydantic-settings)

# === Application ===
WATCHTOWER_ENVIRONMENT=development  # development|production|testing
WATCHTOWER_DEBUG=false
WATCHTOWER_APP_NAME=Watchtower

# === API ===
WATCHTOWER_API_ENABLED=true
WATCHTOWER_API_MASTER_KEY=watchtower-dev-key
WATCHTOWER_API__HOST=0.0.0.0
WATCHTOWER_API__PORT=8000

# === Security ===
WATCHTOWER_SECURITY__SECRET_KEY=change-me-to-random-string
WATCHTOWER_SECURITY__ALGORITHM=HS256

# === Scraping ===
WATCHTOWER_SCRAPING__TIMEOUT=30
WATCHTOWER_SCRAPING__MAX_RETRIES=3
WATCHTOWER_SCRAPING__RETRY_DELAY=5
WATCHTOWER_SCRAPING__CONCURRENT_LIMIT=10
WATCHTOWER_SCRAPING__RATE_LIMIT=1.0
WATCHTOWER_SCRAPING__PLAYWRIGHT_HEADLESS=true

# === Database ===
WATCHTOWER_DATABASE__URL=sqlite:///watchtower.db

# === Logging ===
WATCHTOWER_LOGGING__LEVEL=INFO
WATCHTOWER_LOGGING__FILE_ENABLED=true
WATCHTOWER_LOGGING__CONSOLE_ENABLED=true

# === Notifications ===
WATCHTOWER_NOTIFICATIONS__ENABLED=false
WATCHTOWER_NOTIFICATIONS__EMAIL_SMTP_HOST=
WATCHTOWER_NOTIFICATIONS__EMAIL_SMTP_PORT=587
WATCHTOWER_NOTIFICATIONS__EMAIL_USERNAME=
WATCHTOWER_NOTIFICATIONS__EMAIL_PASSWORD=
WATCHTOWER_NOTIFICATIONS__EMAIL_FROM=
WATCHTOWER_NOTIFICATIONS__SLACK_WEBHOOK_URL=

# === External API Keys ===
WATCHTOWER_API__NEWS_API_KEY=
WATCHTOWER_API__MAL_CLIENT_ID=

# === LLM (optional) ===
WATCHTOWER_LLM__API_KEY=
WATCHTOWER_LLM__MODEL=
WATCHTOWER_LLM__BASE_URL=

# === Google Drive (optional) ===
WATCHTOWER_GOOGLE_DRIVE__CREDENTIALS_FILE=
WATCHTOWER_GOOGLE_DRIVE__FOLDER_ID=

# === Paths (auto-detected if empty) ===
# WATCHTOWER_PROJECT_ROOT=/path/to/watchtower
# WATCHTOWER_DATA_DIR=data
# WATCHTOWER_LOGS_DIR=logs
# WATCHTOWER_CONFIG_DIR=config
