# Normalize line endings per file type.
# Shell scripts MUST be LF — they run inside the Linux/Unraid container and
# CRLF endings break bash (shellcheck SC1017) and the ETL supervisor.

# Shell scripts: always LF (regardless of OS checkout)
*.sh           text eol=lf
*.bash         text eol=lf

# Docker/Unix config files: always LF
Dockerfile*    text eol=lf
*.env*         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf

# Python / config / docs: let git normalize (LF in repo, native on checkout)
*.py           text
*.toml         text
*.cfg          text
*.ini          text
*.md           text
*.json         text
*.txt          text

# Binary assets — never normalize
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.svg          text
*.tar          binary
*.gz           binary
